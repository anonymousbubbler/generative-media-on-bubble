          "editor": "DynamicValue",
          "rank": 1
        },
        "ZAC": {
          "name": "initial_input_json",
          "caption": "Initial inputs JSON",
          "value": "text",
          "optional": true,
          "doc": "Optional saved inputs to restore. Do not bind this property to this element's own input_json state; that would overwrite typing or create a circular dependency.",
          "editor": "DynamicValue",
          "rank": 2
        },
        "ZAD": {
          "name": "media_field_path",
          "caption": "External file field path",
          "value": "text",
          "optional": true,
          "doc": "Optional JSON pointer for a Bubble uploader URL, such as /image_url or /reference_images/0. Keep blank to use the built-in upload controls.",
          "editor": "DynamicValue",
          "rank": 3
        },
        "ZAE": {
          "name": "media_url",
          "caption": "External Bubble file URL",
          "value": "text",
          "optional": true,
          "doc": "Optional public HTTPS file URL from a Bubble uploader. Paired with External file field path. Private file access needs an authorized transfer; no private-file compatibility is claimed.",
          "editor": "DynamicValue",
          "rank": 4
        },
        "ZAF": {
          "name": "submit_label",
          "caption": "Generate button label",
          "value": "text",
          "optional": true,
          "doc": "Defaults to Generate.",
          "editor": "DynamicValue",
          "rank": 5
        },
        "ZAG": {
          "name": "show_submit_button",
          "caption": "Show Generate button",
          "value": "boolean",
          "optional": true,
          "default": true,
          "editor": "DynamicValue",
          "rank": 6,
          "default_val": true
        },
        "ZAH": {
          "name": "show_advanced",
          "caption": "Expand advanced settings",
          "value": "boolean",
          "optional": true,
          "default": false,
          "editor": "DynamicValue",
          "rank": 7,
          "default_val": false
        },
        "ZAI": {
          "name": "disabled",
          "caption": "Disable inputs",
          "value": "boolean",
          "optional": true,
          "default": false,
          "editor": "DynamicValue",
          "rank": 8,
          "default_val": false
        },
        "ZAJ": {
          "name": "watch_job_id",
          "caption": "Job to refresh automatically",
          "value": "text",
          "optional": true,
          "doc": "Authorized saved job ID. This element only requests workflow refreshes; it never calls fal itself.",
          "editor": "DynamicValue",
          "rank": 9
        },
        "ZAK": {
          "name": "watch_enabled",
          "caption": "Enable active job refresh",
          "value": "boolean",
          "optional": true,
          "default": false,
          "doc": "Enable only while the owned saved job has a request ID and is pending or awaiting its result. Disable for completed, failed or uncertain jobs. Maximum 20 checks or five minutes.",
          "editor": "DynamicValue",
          "rank": 10,
          "default_val": false
        },
        "ZAL": {
          "name": "watch_busy",
          "caption": "Job workflow is busy",
          "value": "boolean",
          "optional": true,
          "default": false,
          "doc": "Bind to the same busy state used by the refresh workflow. Set busy before work and clear it after work. Busy blocks checks but does not replace the correlated acknowledgment.",
          "editor": "DynamicValue",
          "rank": 11,
          "default_val": false
        },
        "ZAM": {
          "name": "simple_mode",
          "caption": "Show prompt first",
          "value": "boolean",
          "optional": true,
          "default": false,
          "doc": "Keep prompt/text controls visible and put other model inputs under Advanced settings. All preset values are retained and validated.",
          "editor": "DynamicValue",
          "rank": 12,
          "default_val": false
        },
        "ZAN": {
          "name": "watch_ack",
          "caption": "Completed refresh acknowledgment",
          "value": "text",
          "optional": true,
          "doc": "For automatic refresh: capture this element's Refresh request token as a workflow parameter when Refresh requested fires. After the workflow finishes, echo that captured token here and clear busy. Never read the current token at completion. Missing or mismatched acknowledgment pauses after 30 seconds; keep a manual refresh fallback.",
          "editor": "DynamicValue",
          "rank": 13
        },
        "ZAO": {
          "name": "submit_disabled",
          "caption": "Disable Generate button",
          "value": "boolean",
          "optional": true,
          "default": false,
          "doc": "Disable generation while keeping prompt and settings editable, for example until an authorized user signs in. App workflows must enforce authorization separately.",
          "editor": "DynamicValue",
          "rank": 14,
          "default_val": false
        },
        "ZAP": {
          "name": "model_choices_json",
          "caption": "Optional model choices JSON",
          "value": "text",
          "optional": true,
          "doc": "Optional array of compatible models: {endpoint_id,label,schema_json,defaults?}. Shows a collapsed model selector. When Model selected fires, commit Selected model endpoint, Selected model schema and Selected model inputs together to this element's endpoint/schema/initial-input properties. The prompt is preserved, other inputs reset to the new model defaults. Selection never generates media.",
          "editor": "DynamicValue",
          "rank": 15
        }
